<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Училищна библиотека</title>
    <style>
        body { font-family: Segoe UI, sans-serif; max-width: 900px; margin: 40px auto; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 10px; border-bottom: 1px solid #ddd; text-align: left; }
        .msg { padding: 10px; background: #eef6ff; border: 1px solid #b6d4fe; border-radius: 6px; }
        .free { color: green; }
        .taken { color: #c00; }
        button { padding: 6px 14px; cursor: pointer; }
    </style>
</head>
<body>
<h1>Училищна библиотека</h1>
@RenderBody()
</body>
</html>