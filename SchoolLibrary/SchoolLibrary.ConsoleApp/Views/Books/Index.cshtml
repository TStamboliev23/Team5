@model IReadOnlyList<Book>
@{
    ViewData["Title"] = "Книги";
}

@if (TempData["Message"] is string message)
{
    <p class="msg">@message</p>
}

<table>
    <thead>
    <tr><th>№</th><th>Заглавие</th><th>Автор</th><th>Статус</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var book in Model)
    {
        <tr>
            <td>@book.Id</td>
            <td>@book.Title</td>
            <td>@book.Author</td>
            <td class="@(book.IsBorrowed ? "taken" : "free")">
                @(book.IsBorrowed ? "Заета" : "Налична")
            </td>
            <td>
                @if (book.IsBorrowed)
                {
                    <form asp-action="Return" asp-route-id="@book.Id" method="post">
                        <button type="submit">Върни</button>
                    </form>
                }
                else
                {
                    <form asp-action="Borrow" asp-route-id="@book.Id" method="post">
                        <button type="submit">Заеми</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>